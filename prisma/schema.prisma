generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model categories {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(120)
  services services[]
}

model clients {
  id        Int      @id @default(autoincrement())
  full_name String   @db.VarChar(150)
  phone     String   @unique @db.VarChar(20)
  email     String?  @db.VarChar(100)
  orders    orders[]
}

model masters {
  id        Int      @id @default(autoincrement())
  full_name String   @db.VarChar(150)
  phone     String   @unique @db.VarChar(20)
  email     String?  @db.VarChar(100)
  address   String?
  orders    orders[]
}

model partners {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(180)
  contact_person String   @db.VarChar(180)
  phone          String   @unique @db.VarChar(20)
  address        String?
  unp            String   @unique @db.VarChar(9)
  specialization String
  is_active      Boolean  @default(true)
  orders         orders[]
}

model services {
  id              Int         @id @default(autoincrement())
  name            String?     @db.VarChar(90)
  price           Int
  unit            PricingUnit @default(FIXED)
  slug            String      @unique @db.VarChar(80)
  isStartingPrice Boolean     @default(false)
  category        Int?
  description     String?
  device_type     DeviceType  @default(COMMON)
  displayOrder    Int         @default(0)
  categories      categories? @relation(fields: [category], references: [id], onUpdate: SetNull, map: "services_category_id_fkey")

  @@index([category], map: "services_category_fkey")
}

enum PricingUnit {
  FIXED
  PER_HOUR
  PER_ITEM
}

enum DeviceType {
  DESKTOP
  LAPTOP
  COMMON
}

enum OrderStatus {
  CREATED  
  IN_PROGRESS
  COMPLETED  
  CANCELLED  
}

model orders {
  id          Int          @id @default(autoincrement())
  client_id   Int?
  status      OrderStatus? @default(CREATED)
  master_id   Int?
  partner_id  Int?
  total_price Int?
  created_at  DateTime?    @default(now())
  description String?
  address     String?

  clients  clients?  @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  masters  masters?  @relation(fields: [master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partners partners? @relation(fields: [partner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([client_id], map: "orders_client_fkey")
  @@index([master_id], map: "orders_master_fkey")
  @@index([partner_id], map: "orders_partner_fkey")
}

model site_settings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
}

model admin_users {
  id        Int      @id @default(autoincrement())
  login     String   @unique
  password  String  
  createdAt DateTime @default(now())
}

model site_pages {
  id                Int             @id @default(autoincrement())
  slug              String          @unique @db.VarChar(50) 
  name              String          @db.VarChar(100)  
  description       String?          @db.VarChar(250)     
  displayInNavigation  Boolean         @default(true) 
  sections  page_sections[]
}

model page_sections {
  id                Int              @id @default(autoincrement())
  page_id           Int
  type              String           @db.VarChar(50) 
  name              String?           @db.VarChar(100) 
  display_order     Int              @default(0)
  is_active         Boolean          @default(true)
  
  props             Json?
  content           Json?

  custom_section_id Int?
  custom_sections   custom_sections? @relation(fields: [custom_section_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  page              site_pages       @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@index([page_id], map: "page_sections_page_fkey")
  @@index([custom_section_id], map: "page_sections_custom_section_fkey")
}

model custom_sections {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(100) 
  props         Json?
  content       Json?            
  
  page_sections page_sections[]
}